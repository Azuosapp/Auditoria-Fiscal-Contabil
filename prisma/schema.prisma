// Auditoria Fiscal e Contábil Azuos
// Ver docs/ARQUITETURA.md e docs/CATALOGO_ACHADOS.md
//
// Regra inegociável: valor monetário é Decimal(18,2) e base de cálculo é Decimal(18,4).
// Nunca Float — arredondamento binário em tributo produz diferença de centavos que
// destrói a credibilidade do relatório.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// ACESSO
// =====================================================================

enum PapelUsuario {
  ADMIN
  AUDITOR
  COMERCIAL
  LEITURA
}

model Organizacao {
  id        String   @id @default(cuid())
  nome      String
  cnpj      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios  Usuario[]
  empresas  Empresa[]
}

model Usuario {
  id             String      @id @default(cuid())
  organizacaoId  String
  organizacao    Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  nome         String
  email        String       @unique
  senhaHash    String
  papel        PapelUsuario @default(AUDITOR)
  ativo        Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditorias Auditoria[]

  @@index([organizacaoId])
}

// =====================================================================
// EMPRESA AUDITADA
// =====================================================================

enum RegimeTributario {
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
  MEI
  IMUNE_ISENTA
  ARBITRADO
}

model Empresa {
  id            String      @id @default(cuid())
  organizacaoId String
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  cnpj               String
  razaoSocial        String
  nomeFantasia       String?
  naturezaJuridica   String?
  cnaePrincipal      String?
  cnaesSecundarios   String[] @default([])
  uf                 String?
  municipio          String?
  inscricaoEstadual  String?
  inscricaoMunicipal String?
  capitalSocial      Decimal? @db.Decimal(18, 2)
  dataAbertura       DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  regimes    RegimePorExercicio[]
  socios     Socio[]
  auditorias Auditoria[]

  @@unique([organizacaoId, cnpj])
  @@index([cnpj])
}

/// O regime muda de ano para ano — e é ele que define QUAL motor de regras aplicar.
/// Sem isto preenchido corretamente, todo cruzamento fica errado.
model RegimePorExercicio {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  exercicio Int
  regime    RegimeTributario
  /// Como o regime foi determinado: informado, extraído do PGDAS, da ECF etc.
  origem    String?

  @@unique([empresaId, exercicio])
  @@index([empresaId])
}

model Socio {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  nome         String
  documento    String
  qualificacao String?
  percentual   Decimal? @db.Decimal(9, 4)
  administrador Boolean @default(false)

  @@index([empresaId])
}

// =====================================================================
// AUDITORIA
// =====================================================================

enum StatusAuditoria {
  RASCUNHO
  IMPORTANDO
  PROCESSANDO
  PRONTA
  ENTREGUE
  ARQUIVADA
}

enum NivelAuditoria {
  DIAGNOSTICO_RAPIDO
  FISCAL
  COMPLETA
}

model Auditoria {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  responsavelId String?
  responsavel   Usuario? @relation(fields: [responsavelId], references: [id], onDelete: SetNull)

  titulo         String
  competenciaIni String          @db.VarChar(7) // "2021-01"
  competenciaFim String          @db.VarChar(7)
  status         StatusAuditoria @default(RASCUNHO)
  /// Nível efetivamente alcançado, conforme os documentos entregues.
  nivelAlcancado NivelAuditoria?

  /// Totais consolidados — recalculados a cada execução do motor.
  totalDebitoAberto  Decimal? @db.Decimal(18, 2)
  totalRiscoAutuacao Decimal? @db.Decimal(18, 2)
  totalRecuperavel   Decimal? @db.Decimal(18, 2)

  executadaEm DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  documentos    Documento[]
  consolidacoes CompetenciaConsolidada[]
  achados       Achado[]
  relatorios    Relatorio[]
  lacunas       Lacuna[]
  analisesIa    AnaliseIa[]

  @@index([empresaId])
  @@index([status])
}

/// O que NÃO foi analisado, e por quê. O relatório sempre declara isto.
model Lacuna {
  id          String    @id @default(cuid())
  auditoriaId String
  auditoria   Auditoria @relation(fields: [auditoriaId], references: [id], onDelete: Cascade)

  /// Código do achado ou família que não pôde ser avaliado.
  escopo          String
  area            AreaAchado @default(FISCAL)
  /// Vazio quando os documentos vieram, mas a verificação ainda não é
  /// automatizada — nenhum documento a mais resolveria.
  documentoFaltante TipoDocumento?
  competencia     String? @db.VarChar(7)
  descricao       String

  @@index([auditoriaId])
}

// =====================================================================
// DOCUMENTOS E EXTRAÇÃO
// =====================================================================

enum TipoDocumento {
  NFE_XML
  NFCE_XML
  NFSE_XML
  EVENTO_NFE
  SPED_FISCAL
  SPED_CONTRIBUICOES
  ECD
  ECF
  DCTF
  DCTFWEB
  SITUACAO_FISCAL
  PGDAS
  COMPROVANTE_ARRECADACAO
  ESOCIAL
  EFD_REINF
  CARTAO_CNPJ
  CONTRATO_SOCIAL
  /// Certidão de débitos (CND, CPEN-D) federal, estadual ou municipal.
  CERTIDAO
  INSCRICAO_ESTADUAL
  /// Recibo de entrega de escrituração (.rec). Guardado como comprovante de
  /// transmissão; não carrega dado fiscal.
  RECIBO_ENTREGA
  PLANILHA
  DESCONHECIDO
}

enum StatusProcessamento {
  PENDENTE
  PROCESSANDO
  CONCLUIDO
  ERRO
  IGNORADO
}

model Documento {
  id          String    @id @default(cuid())
  auditoriaId String
  auditoria   Auditoria @relation(fields: [auditoriaId], references: [id], onDelete: Cascade)

  nomeArquivo String
  /// Tipo detectado pelo CONTEÚDO, não pela extensão nem pelo nome.
  tipo        TipoDocumento
  tipoInformado TipoDocumento?
  tamanhoBytes Int
  /// SHA-256 — impede reprocessar o mesmo arquivo duas vezes.
  hash        String
  caminho     String
  status      StatusProcessamento @default(PENDENTE)
  parser      String?
  registrosExtraidos Int  @default(0)
  erros       Json?
  metadados   Json?

  processadoEm DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  notas             NotaFiscal[]
  apuracoesFiscais  ApuracaoFiscal[]
  apuracoesContrib  ApuracaoContribuicoes[]
  lancamentos       LancamentoContabil[]
  linhasDre         LinhaDre[]
  contasContabeis   ContaContabil[]
  linhasEcf         LinhaEcf[]
  sociosEcf         SocioEcf[]
  escrituracao      EscrituracaoArquivo?
  difal             ApuracaoDifal[]
  apuracoesIpi      ApuracaoIpi[]
  inventarios       Inventario[]
  saldos            SaldoConta[]
  apuracoesEcf      ApuracaoEcf[]
  confissoes        Confissao[]
  arrecadacoes      Arrecadacao[]
  pendenciasFiscais PendenciaFiscal[]
  apuracoesSimples  ApuracaoSimples[]
  eventos           EventoNfe[]
  retratoSituacao   RetratoSituacaoFiscal?

  @@unique([auditoriaId, hash])
  @@index([auditoriaId, tipo])
  @@index([status])
}

// ---------- Fiscal: documentos emitidos ----------

enum DirecaoNota {
  ENTRADA
  SAIDA
}

/// De onde a nota veio. O achado B01 confronta um lado com o outro: sem
/// distinguir a origem, o cruzamento compararia a nota com ela mesma.
enum OrigemNota {
  /// XML autorizado pela SEFAZ — o que a empresa realmente emitiu ou recebeu.
  XML_AUTORIZADO
  /// Registro C100 do SPED Fiscal — o que a contabilidade escriturou.
  ESCRITURACAO
}

enum SituacaoNota {
  AUTORIZADA
  CANCELADA
  DENEGADA
  INUTILIZADA
}

model NotaFiscal {
  id          String    @id @default(cuid())
  documentoId String
  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  chave        String?  @db.VarChar(44)
  modelo       String   @db.VarChar(2) // 55, 65, 57, NFS-e
  serie        String?
  numero       String
  direcao      DirecaoNota
  origem       OrigemNota
  situacao     SituacaoNota @default(AUTORIZADA)
  dataEmissao  DateTime
  competencia  String   @db.VarChar(7)

  cnpjEmitente     String
  cnpjDestinatario String?
  ufDestino        String?
  consumidorFinal  Boolean?
  /// indIEDest: 1 contribuinte, 2 isento, 9 não contribuinte.
  indicadorIeDestinatario String? @db.VarChar(1)
  destinatarioContribuinte Boolean?

  valorTotal   Decimal @db.Decimal(18, 2)
  valorProdutos Decimal? @db.Decimal(18, 2)
  baseIcms     Decimal? @db.Decimal(18, 2)
  valorIcms    Decimal? @db.Decimal(18, 2)
  valorIcmsSt  Decimal? @db.Decimal(18, 2)
  valorIpi     Decimal? @db.Decimal(18, 2)
  valorPis     Decimal? @db.Decimal(18, 2)
  valorCofins  Decimal? @db.Decimal(18, 2)
  valorIss     Decimal? @db.Decimal(18, 2)

  /// Marcado quando o SPED Fiscal escriturou esta chave (regra B01).
  escriturada  Boolean @default(false)

  itens NotaFiscalItem[]

  @@index([documentoId])
  @@index([chave])
  @@index([competencia, direcao])
  @@index([origem, chave])
}

/// Evento de NF-e (cancelamento, carta de correção, manifestação).
///
/// NÃO é nota: é documento à parte que se refere a uma nota pela chave, e chega
/// no MESMO pacote das notas. Tratar evento como nota infla o faturamento;
/// ignorá-lo faz nota cancelada seguir contando como receita.
model EventoNfe {
  id          String    @id @default(cuid())
  documentoId String
  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  chave       String   @db.VarChar(44)
  tipoEvento  String   @db.VarChar(6)
  descricao   String?
  dataEvento  DateTime?
  sequencia   Int?
  autorDoc    String?
  protocolo   String?
  /// Só o evento 110111 cancela.
  cancelaNota Boolean  @default(false)

  @@index([documentoId])
  @@index([chave])
}

model NotaFiscalItem {
  id     String     @id @default(cuid())
  notaId String
  nota   NotaFiscal @relation(fields: [notaId], references: [id], onDelete: Cascade)

  numeroItem  Int
  codigo      String?
  descricao   String?
  ncm         String?  @db.VarChar(8)
  cfop        String?  @db.VarChar(4)
  cstIcms     String?  @db.VarChar(3)
  cstPis      String?  @db.VarChar(2)
  cstCofins   String?  @db.VarChar(2)
  quantidade  Decimal? @db.Decimal(18, 4)
  valorItem   Decimal  @db.Decimal(18, 2)
  aliqIcms    Decimal? @db.Decimal(9, 4)
  baseIcms    Decimal? @db.Decimal(18, 2)
  valorIcms   Decimal? @db.Decimal(18, 2)
  valorIcmsSt Decimal? @db.Decimal(18, 2)
  valorIpi    Decimal? @db.Decimal(18, 2)
  /// ICMSUFDest.vICMSUFDest — DIFAL devido à UF de destino (EC 87/2015).
  valorDifal  Decimal? @db.Decimal(18, 2)
  aliqPis     Decimal? @db.Decimal(9, 4)
  aliqCofins  Decimal? @db.Decimal(9, 4)
  /// Origem da mercadoria (tabela A do CST): 0 nacional; 1, 2, 3 e 8 com conteúdo importado.
  origemMercadoria String? @db.VarChar(1)
  /// Grupo IBSCBS presente no item.
  temIbsCbs   Boolean?

  @@index([notaId])
  @@index([ncm])
}

// ---------- Fiscal: apuração declarada ----------

/// SPED EFD ICMS/IPI — Bloco E (E110 e afins).
model ApuracaoFiscal {
  id          String    @id @default(cuid())
  documentoId String
  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  competencia   String  @db.VarChar(7)
  uf            String?

  debitos       Decimal @db.Decimal(18, 2)
  creditos      Decimal @db.Decimal(18, 2)
  saldoCredorAnterior Decimal? @db.Decimal(18, 2)
  deducoes      Decimal? @db.Decimal(18, 2)
  /// E110 campo "ICMS a recolher" — o número que a família A confere.
  icmsARecolher Decimal @db.Decimal(18, 2)
  saldoCredorTransportar Decimal? @db.Decimal(18, 2)

  registroOrigem String? // "E110"
  linhaOrigem    Int?

  @@unique([documentoId, competencia])
  @@index([competencia])
}

enum TipoContribuicao {
  PIS
  COFINS
}

/// EFD-Contribuições — M200 (PIS) e M600 (COFINS).
model ApuracaoContribuicoes {
  id          String    @id @default(cuid())
  documentoId String
  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  competencia   String @db.VarChar(7)
  contribuicao  TipoContribuicao

  baseCalculo   Decimal? @db.Decimal(18, 2)
  valorApurado  Decimal  @db.Decimal(18, 2)
  creditos      Decimal? @db.Decimal(18, 2)
  retencoes     Decimal? @db.Decimal(18, 2)
  /// Valor a recolher no período.
  aRecolher     Decimal  @db.Decimal(18, 2)

  registroOrigem String?
  linhaOrigem    Int?

  @@unique([documentoId, competencia, contribuicao])
  @@index([competencia])
}

/// PGDAS-D — Simples Nacional.
model ApuracaoSimples {
  id          String    @id @default(cuid())
  documentoId String
  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  competencia    String  @db.VarChar(7)
  rbt12          Decimal @db.Decimal(18, 2)
  receitaBruta   Decimal @db.Decimal(18, 2)
  anexo          String?
  aliquotaEfetiva Decimal? @db.Decimal(9, 4)
  fatorR         Decimal? @db.Decimal(9, 4)
  valorDas       Decimal @db.Decimal(18, 2)
  /// ICMS e ISS destacados fora do DAS quando o sublimite é ultrapassado.
  icmsForaDas    Decimal? @db.Decimal(18, 2)
  issForaDas     Decimal? @db.Decimal(18, 2)
  /// "Impedido de recolher ICMS/ISS no DAS" — o sublimite dito pelo próprio
  /// Fisco no extrato. Vale mais que qualquer inferência nossa sobre o RBT12.
  impedidoIcmsIssNoDas Boolean?
  /// Tributos federais discriminados no extrato, para o comparativo de regimes.
  irpj   Decimal? @db.Decimal(18, 2)
  csll   Decimal? @db.Decimal(18, 2)
  pis    Decimal? @db.Decimal(18, 2)
  cofins Decimal? @db.Decimal(18, 2)
  cpp    Decimal? @db.Decimal(18, 2)
  icms   Decimal? @db.Decimal(18, 2)
  iss    Decimal? @db.Decimal(18, 2)

  @@unique([documentoId, competencia])
  @@index([competencia])
}

// ---------- Contábil ----------

/// ECD — lançamentos do razão (registros I200/I250).
model LancamentoContabil {
  id          String    @id @default(cuid())
  documentoId String
  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  data        DateTime
  competencia String  @db.VarChar(7)
  numeroLancamento String?
  contaCodigo String
  contaNome   String?
  /// "D" ou "C"
  natureza    String  @db.VarChar(1)
  valor       Decimal @db.Decimal(18, 2)
  historico   String?
  /// I200 IND_LCTO: N normal, E encerramento do exercício, X extemporâneo.
  tipoLancamento String? @db.VarChar(1)

  linhaOrigem Int?

  @@index([documentoId, competencia])
  @@index([contaCodigo])
}

/// ECD — saldos por conta e período (registro I155). É daqui que sai o caixa negativo.
model SaldoConta {
  id          String    @id @default(cuid())
  documentoId String
  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  competencia    String  @db.VarChar(7)
  contaCodigo    String
  contaNome      String?
  /// Classificação para as regras: CAIXA, BANCO, MUTUO_SOCIO, RECEITA, TRIBUTO...
  classificacao  String?
  saldoInicial   Decimal @db.Decimal(18, 2)
  debitos        Decimal @db.Decimal(18, 2)
  creditos       Decimal @db.Decimal(18, 2)
  saldoFinal     Decimal @db.Decimal(18, 2)
  /// "D" ou "C" — saldo credor em conta de caixa é o achado F01.
  naturezaSaldo  String  @db.VarChar(1)

  linhaOrigem Int?

  @@unique([documentoId, competencia, contaCodigo])
  @@index([competencia, classificacao])
}

/// ECF — apuração de IRPJ e CSLL.
model ApuracaoEcf {
  id          String    @id @default(cuid())
  documentoId String
  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  exercicio   Int
  periodo     String @db.VarChar(7) // trimestre ou ano
  tributo     String @db.VarChar(5) // IRPJ | CSLL

  receitaDeclarada Decimal? @db.Decimal(18, 2)
  lucroContabil    Decimal? @db.Decimal(18, 2)
  adicoes          Decimal? @db.Decimal(18, 2)
  exclusoes        Decimal? @db.Decimal(18, 2)
  baseCalculo      Decimal  @db.Decimal(18, 2)
  valorApurado     Decimal  @db.Decimal(18, 2)
  adicional        Decimal? @db.Decimal(18, 2)
  deducoes         Decimal? @db.Decimal(18, 2)
  aPagar           Decimal  @db.Decimal(18, 2)

  registroOrigem String?
  linhaOrigem    Int?

  @@index([documentoId, exercicio])
}

// ---------- Confessado e pago ----------

/// DCTF / DCTFWeb — o que foi confessado à Receita.
model Confissao {
  id          String    @id @default(cuid())
  documentoId String
  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  competencia   String  @db.VarChar(7)
  tributo       String  @db.VarChar(20)
  codigoReceita String? @db.VarChar(6)
  valorDebito   Decimal @db.Decimal(18, 2)
  /// Data da declaração. O mesmo débito trimestral volta nas DCTFs de vários
  /// meses; no confronto vale o da declaração mais recente.
  dataDeclaracao DateTime?
  /// Vinculações que quitam sem DARF — evitam falso positivo na família A.
  valorPago        Decimal? @db.Decimal(18, 2)
  valorCompensado  Decimal? @db.Decimal(18, 2)
  valorParcelado   Decimal? @db.Decimal(18, 2)
  valorSuspenso    Decimal? @db.Decimal(18, 2)
  saldoDevedor     Decimal? @db.Decimal(18, 2)

  @@index([documentoId, competencia])
  @@index([tributo, competencia])
}

/// DARF, DAS, DARE-GO, GNRE — o que foi efetivamente pago.
model Arrecadacao {
  id          String    @id @default(cuid())
  documentoId String
  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  competencia   String   @db.VarChar(7)
  tributo       String   @db.VarChar(20)
  codigoReceita String?  @db.VarChar(6)
  dataPagamento DateTime?
  dataVencimento DateTime?
  principal     Decimal  @db.Decimal(18, 2)
  multa         Decimal? @db.Decimal(18, 2)
  juros         Decimal? @db.Decimal(18, 2)
  valorTotal    Decimal  @db.Decimal(18, 2)

  @@index([documentoId, competencia])
  @@index([tributo, competencia])
}

/// Relatório de Situação Fiscal do e-CAC — pendências em aberto.
///
/// É o que o Fisco já sabe e o cliente muitas vezes não. Fica em tabela própria,
/// separado dos achados, porque não é conclusão nossa: é o registro do próprio
/// órgão, e na apresentação vale exatamente por isso.
model PendenciaFiscal {
  id          String    @id @default(cuid())
  documentoId String
  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  /// DEBITO | OMISSAO_DECLARACAO | PARCELAMENTO | DIVIDA_ATIVA |
  /// IRREGULARIDADE_CADASTRAL | OUTRA
  natureza      String
  /// RFB ou PGFN — o órgão que registra a pendência.
  orgao         String  @db.VarChar(4)
  descricao     String
  /// Código e nome da receita, como impresso ("5952-07 - CSRF").
  receita       String?
  /// Período de apuração, como impresso. Nem sempre é competência AAAA-MM.
  periodo       String?
  vencimento    String?
  valorOriginal   Decimal? @db.Decimal(18, 2)
  saldoDevedor    Decimal? @db.Decimal(18, 2)
  multa           Decimal? @db.Decimal(18, 2)
  juros           Decimal? @db.Decimal(18, 2)
  /// Principal + multa + juros. É este o número que vai para a apresentação.
  saldoConsolidado Decimal? @db.Decimal(18, 2)
  situacao      String?
  /// Inscrição em dívida ativa, processo ou conta de parcelamento.
  identificacao String?

  @@index([documentoId])
  @@index([natureza])
}

/// Retrato cadastral e de conformidade extraído do Relatório de Situação Fiscal.
/// Um por documento importado — o relatório é uma fotografia de uma data.
model RetratoSituacaoFiscal {
  id          String    @id @default(cuid())
  documentoId String    @unique
  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  cnpj              String?
  razaoSocial       String?
  situacaoCadastral String?
  motivoSituacao    String?
  naturezaJuridica  String?
  cnae              String?
  porte             String?
  dataAbertura      String?
  municipio         String?
  uf                String?
  unidadeAdministrativa String?
  responsavel       String?
  emitidoEm         String?
  certidaoNumero    String?
  certidaoEmissao   String?
  certidaoValidade  String?
  /// O relatório afirma, com todas as letras, que não há pendência.
  semPendencias     Boolean @default(false)
  /// Sócios e administradores como o relatório os lista.
  socios            Json?
  avisos            Json?

  criadoEm DateTime @default(now())
}

// =====================================================================
// CONSOLIDAÇÃO — o coração do sistema
// =====================================================================

/// Visão única por competência e tributo: o que foi apurado, confessado, pago e
/// qual a receita real. Com esta tabela pronta, a família A do catálogo vira uma
/// comparação de colunas — rápida, testável e com evidência anexada.
model CompetenciaConsolidada {
  id          String    @id @default(cuid())
  auditoriaId String
  auditoria   Auditoria @relation(fields: [auditoriaId], references: [id], onDelete: Cascade)

  competencia String @db.VarChar(7)
  tributo     String @db.VarChar(20)

  apurado    Decimal? @db.Decimal(18, 2)
  confessado Decimal? @db.Decimal(18, 2)
  pago       Decimal? @db.Decimal(18, 2)
  compensado Decimal? @db.Decimal(18, 2)
  parcelado  Decimal? @db.Decimal(18, 2)
  suspenso   Decimal? @db.Decimal(18, 2)
  emAberto   Decimal? @db.Decimal(18, 2)

  receitaReal        Decimal? @db.Decimal(18, 2)
  receitaEscriturada Decimal? @db.Decimal(18, 2)
  receitaContabil    Decimal? @db.Decimal(18, 2)

  /// De onde veio cada número: [{campo, fonte, documentoId, registro, linha}]
  origens Json?

  @@unique([auditoriaId, competencia, tributo])
  @@index([auditoriaId, competencia])
}

// =====================================================================
// ACHADOS
// =====================================================================

/// Em que parte do relatório o achado aparece. Erro de apuração e de documento
/// fiscal é uma conversa; pagamento, confissão e escrituração contábil é outra.
enum AreaAchado {
  FISCAL
  CONTABIL
}

enum Severidade {
  CRITICO
  ALTO
  MEDIO
  BAIXO
  OPORTUNIDADE
}

enum Confianca {
  ALTA
  MEDIA
  BAIXA
}

enum SituacaoPrescricional {
  EXIGIVEL
  A_DECAIR
  DECAIDO
}

model Achado {
  id          String    @id @default(cuid())
  auditoriaId String
  auditoria   Auditoria @relation(fields: [auditoriaId], references: [id], onDelete: Cascade)

  /// Código do catálogo: A01, B03, F01... Ver docs/CATALOGO_ACHADOS.md
  codigo    String @db.VarChar(6)
  titulo    String
  familia   String
  area      AreaAchado @default(FISCAL)
  severidade Severidade
  confianca  Confianca @default(ALTA)

  tributo     String? @db.VarChar(20)
  competencia String? @db.VarChar(7)
  exercicio   Int?

  descricao String
  /// Frase pronta para a apresentação ao cliente.
  textoCliente String?
  recomendacao String?

  valorExposicao  Decimal? @db.Decimal(18, 2)
  valorAtualizado Decimal? @db.Decimal(18, 2)

  baseLegal String[] @default([])

  situacaoPrescricional SituacaoPrescricional @default(EXIGIVEL)
  decaiEm               DateTime?
  /// Qual regra de contagem foi usada: "CTN art. 173, I" ou "CTN art. 150, § 4º".
  regraDecadencia       String?

  /// Quando a confiança não é ALTA, o que precisa ser conferido.
  ressalva String?

  createdAt DateTime @default(now())

  evidencias Evidencia[]

  @@index([auditoriaId, area, severidade])
  @@index([auditoriaId, severidade])
  @@index([auditoriaId, codigo])
  @@index([competencia])
}

/// Para que serve cada evidência no relatório.
enum TipoEvidencia {
  /// O caso concreto: esta nota, esta chave, este valor. É o que convence o
  /// cliente — "foi calculado" não move ninguém; "olhe a nota 3001" move.
  EXEMPLO
  /// O número confrontado, de onde saiu e quanto deu.
  CONFRONTO
  /// Contexto de apoio: totais, quantidades, origem do arquivo.
  CONTEXTO
}

/// Rastro até o documento do cliente. Achado sem evidência não entra no relatório.
model Evidencia {
  id       String @id @default(cuid())
  achadoId String
  achado   Achado @relation(fields: [achadoId], references: [id], onDelete: Cascade)

  tipo        TipoEvidencia @default(CONTEXTO)
  documentoId String?
  arquivo     String
  registro    String?
  linha       Int?
  campo       String?
  valor       String?
  observacao  String?

  /// Identificação do documento fiscal no exemplo: número, série, chave, data.
  /// Guardados em coluna própria para o relatório exibi-los em tabela.
  documentoNumero String?
  chave           String?
  dataDocumento   String?
  participante    String?

  @@index([achadoId])
  @@index([achadoId, tipo])
}

// =====================================================================
// RELATÓRIO
// =====================================================================

enum FormatoRelatorio {
  TELA
  PDF
  XLSX
  APRESENTACAO
}

model Relatorio {
  id          String    @id @default(cuid())
  auditoriaId String
  auditoria   Auditoria @relation(fields: [auditoriaId], references: [id], onDelete: Cascade)

  formato   FormatoRelatorio
  caminho   String?
  geradoEm  DateTime @default(now())
  /// Cópia dos totais no momento da geração — o relatório entregue não muda depois.
  snapshot  Json?

  @@index([auditoriaId])
}

// =====================================================================
// TRILHA
// =====================================================================

model LogAuditoria {
  id        String   @id @default(cuid())
  usuarioId String?
  acao      String
  entidade  String
  entidadeId String?
  detalhes  Json?
  criadoEm  DateTime @default(now())

  @@index([entidade, entidadeId])
  @@index([criadoEm])
}

// =====================================================================
// IMPORTAÇÃO
// =====================================================================

enum StatusLote {
  ANALISADO
  CONFIRMADO
  DESCARTADO
}

/// Lote de arquivos recebidos antes de existir empresa ou auditoria.
///
/// O usuário solta 5 anos de documentos e o sistema deduz de quem são. Como a
/// dedução precisa ser confirmada antes de criar a empresa, os arquivos ficam
/// aqui entre a análise e a confirmação — evitando um segundo upload de
/// centenas de megabytes.
model LoteImportacao {
  id String @id @default(cuid())

  status      StatusLote @default(ANALISADO)
  caminho     String
  totalArquivos Int      @default(0)
  totalBytes  BigInt     @default(0)

  /// Resultado da análise: identidade deduzida, período, regimes, tipos lidos.
  analise Json?

  auditoriaId String?
  criadoEm    DateTime @default(now())
  confirmadoEm DateTime?

  @@index([status])
}

// ---------- Análise do Claude ----------

enum StatusAnaliseIa {
  EM_ANDAMENTO
  CONCLUIDA
  /// O teto de gasto foi atingido antes do fim: o que veio é parcial ou nada.
  LIMITE_ATINGIDO
  ERRO
}

/// Uma rodada da análise tributária feita pelo Claude sobre a auditoria.
///
/// Fica separada de `Achado` de propósito: achado é regra programada e testada,
/// com número reproduzível; apontamento do Claude é leitura de um auditor, a
/// confirmar. Misturar os dois faria o relatório tratar hipótese como cálculo.
model AnaliseIa {
  id          String    @id @default(cuid())
  auditoriaId String
  auditoria   Auditoria @relation(fields: [auditoriaId], references: [id], onDelete: Cascade)

  status      StatusAnaliseIa @default(EM_ANDAMENTO)
  modelo      String?
  iniciadaEm  DateTime        @default(now())
  concluidaEm DateTime?
  duracaoSeg  Int?
  /// Custo a preço de tabela informado pelo Claude Code. Na assinatura não é
  /// cobrado em dinheiro, mas mede o consumo do limite — e é a base do teto.
  custoUsd    Decimal? @db.Decimal(10, 4)
  resumo      String?  @db.Text
  documentosFaltantes String[] @default([])
  erro        String?  @db.Text

  apontamentos ApontamentoIa[]

  @@index([auditoriaId, iniciadaEm])
}

model ApontamentoIa {
  id        String    @id @default(cuid())
  analiseId String
  analise   AnaliseIa @relation(fields: [analiseId], references: [id], onDelete: Cascade)

  ordem         Int
  titulo        String
  severidade    Severidade
  area          AreaAchado
  confianca     Confianca
  tributo       String?
  competencias  String[] @default([])
  valorEstimado Decimal? @db.Decimal(18, 2)
  descricao     String   @db.Text
  recomendacao  String?  @db.Text
  baseLegal     String[] @default([])
  /// [{ arquivo, localizacao, detalhe, valor }] — onde conferir.
  evidencias    Json

  @@index([analiseId])
}

/// ECD — Demonstração do Resultado (registro J150), por período do J005.
/// É daqui que sai a receita bruta escriturada, confrontada com a da ECF (B09).
model LinhaDre {
  id          String    @id @default(cuid())
  documentoId String
  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  dataInicio  DateTime
  dataFim     DateTime
  ordem       Int
  codigoAglutinacao String
  descricao   String
  nivel       Int?
  /// "T" totalizador ou "D" detalhe
  tipo        String? @db.VarChar(1)
  valor       Decimal @db.Decimal(18, 2)
  /// "D" ou "C"
  natureza    String? @db.VarChar(1)

  @@index([documentoId, dataFim])
}

/// Dados de controle de um arquivo de escrituração (SPED Fiscal, EFD-Contribuições):
/// o que as regras de obrigação acessória precisam — prazo, atividade, Bloco K.
model EscrituracaoArquivo {
  id          String    @id @default(cuid())
  documentoId String    @unique
  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  competencia    String   @db.VarChar(7)
  /// 0000 IND_ATIV: 0 industrial ou equiparado, 1 outros.
  indAtividade   String?  @db.VarChar(1)
  /// COM_DADOS, SEM_DADOS ou AUSENTE.
  blocoK         String?
  /// signingTime da assinatura digital, em UTC.
  dataAssinatura DateTime?
  /// 0000 COD_FIN: 0 original, 1 retificadora.
  finalidade     String?  @db.VarChar(1)
}

/// SPED Fiscal E300/E310 — DIFAL e FCP por UF de destino.
model ApuracaoDifal {
  id          String    @id @default(cuid())
  documentoId String
  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  competencia   String   @db.VarChar(7)
  uf            String   @db.VarChar(2)
  totalDebitos  Decimal  @db.Decimal(18, 2)
  totalCreditos Decimal? @db.Decimal(18, 2)
  aRecolher     Decimal? @db.Decimal(18, 2)

  @@index([documentoId, competencia])
}

/// SPED Fiscal H005/H010 — inventário.
model Inventario {
  id          String    @id @default(cuid())
  documentoId String
  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  /// Competência do arquivo que trouxe o inventário (em regra, fevereiro).
  competencia    String   @db.VarChar(7)
  dataInventario DateTime?
  valor          Decimal? @db.Decimal(18, 2)
  motivo         String?  @db.VarChar(2)
  somaItens      Decimal? @db.Decimal(18, 2)
  itens          Int

  @@index([documentoId])
}

/// ECD I050/I051 — plano de contas com natureza, tipo, nível e referencial.
model ContaContabil {
  id          String    @id @default(cuid())
  documentoId String
  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  codigo         String
  nome           String
  /// COD_NAT: 01 ativo, 02 passivo, 03 patrimônio líquido, 04 resultado, 05 compensação, 09 outras.
  natureza       String  @db.VarChar(2)
  /// S sintética, A analítica.
  tipo           String  @db.VarChar(1)
  nivel          Int
  codigoSuperior String?
  /// Conta do plano referencial da Receita (I051).
  referencial    String?

  @@unique([documentoId, codigo])
  @@index([documentoId, referencial])
}

/// ECF — linhas dos demonstrativos e apurações (L100, L300, M300, M350, N500,
/// N630, N650, N670, P100, P150, P300, P500), só as de valor informado.
model LinhaEcf {
  id          String    @id @default(cuid())
  documentoId String
  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  exercicio   Int
  /// Período do bloco: A00 anual, T01 a T04 trimestral, A01 a A12 estimativa.
  periodo     String  @db.VarChar(3)
  dataFim     DateTime
  registro    String  @db.VarChar(4)
  codigo      String
  descricao   String
  valor       Decimal? @db.Decimal(18, 2)
  /// D ou C, quando o registro informa.
  indicador   String?  @db.VarChar(1)
  valorInicial     Decimal? @db.Decimal(18, 2)
  indicadorInicial String?  @db.VarChar(1)
  debitos     Decimal? @db.Decimal(18, 2)
  creditos    Decimal? @db.Decimal(18, 2)

  @@index([documentoId, registro, codigo])
}

/// ECF Y600 — quadro societário do exercício, com as remunerações pagas a cada sócio.
model SocioEcf {
  id          String    @id @default(cuid())
  documentoId String
  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  exercicio          Int
  dataEntrada        DateTime?
  dataSaida          DateTime?
  tipoPessoa         String?  @db.VarChar(2)
  documentoSocio     String
  nome               String
  qualificacao       String?
  percentualCapital  Decimal? @db.Decimal(9, 4)
  percentualVotante  Decimal? @db.Decimal(9, 4)
  remuneracaoTrabalho Decimal? @db.Decimal(18, 2)
  lucrosDividendos   Decimal? @db.Decimal(18, 2)
  jurosCapital       Decimal? @db.Decimal(18, 2)
  demaisRendimentos  Decimal? @db.Decimal(18, 2)
  irRetido           Decimal? @db.Decimal(18, 2)

  @@index([documentoId])
}

/// SPED Fiscal E500/E520 — apuração do IPI. É o que a DCTF deve confessar.
model ApuracaoIpi {
  id          String    @id @default(cuid())
  documentoId String
  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  competencia  String   @db.VarChar(7)
  debitos      Decimal? @db.Decimal(18, 2)
  creditos     Decimal? @db.Decimal(18, 2)
  saldoCredor  Decimal? @db.Decimal(18, 2)
  aRecolher    Decimal  @db.Decimal(18, 2)

  @@index([documentoId, competencia])
}
